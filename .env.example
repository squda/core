# Copy to .env and fill in. .env is gitignored — the service role key is a
# server secret and must never reach a browser, a log, or this repository.

# Supabase — from Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth is required by default once Supabase is set. Set to 0 to run open
# while you are still wiring a client up.
# REQUIRE_AUTH=0

# Browser origins allowed to call this service, comma-separated. Empty means no
# CORS headers at all, which is the right default. Never '*' — with credentials
# allowed, a wildcard hands any page on the internet a caller's token.
# In development apps/web proxies /api instead, so it needs nothing here.
# CORS_ORIGINS=http://localhost:5173

# How long one fetch may take. Raise it when getting the page matters more than
# getting it quickly — then raise whatever enforces a limit above it too, and
# leave about 15s of room: an `auto` scrape can spend this on HTTP and again on
# the browser, then dismiss consent and expand tabs on top. On Lambda, a
# function timeout below that arrives as a 502 that says nothing about a slow
# page. FETCH_TIMEOUT_MS=60000 wants a Lambda timeout around 90s.
# FETCH_TIMEOUT_MS=30000

# The same for /demo, and deliberately shorter: a visitor is watching a spinner,
# and thirty seconds of nothing on a waitlist page is a closed tab.
# DEMO_TIMEOUT_MS=20000

# The open /demo endpoint: reads per caller per window. Everything else needs a
# token, so this cap is what stands between a public demo and a free scraper.
# DEMO_RATE_LIMIT=10
# DEMO_WINDOW_MS=600000

# Chromium launch flags, comma-separated. Empty on a laptop; a container needs
# both of these, and packages/core/Dockerfile sets them so you do not have to.
# --no-sandbox because a hardened runtime denies the syscalls Chromium's own
# sandbox is built from; --disable-dev-shm-usage because Docker's 64MB /dev/shm
# is smaller than Chromium wants, and the crash looks like a timeout.
# CHROMIUM_ARGS=--no-sandbox,--disable-dev-shm-usage

# PORT=3000
# LOG_LEVEL=info
# BROWSER_CONCURRENCY=2
# JOB_CONCURRENCY=4
# MAX_QUEUED=100

# Scrape private/loopback addresses. Local development only — never in
# production, where it re-opens the SSRF hole the guard exists to close.
# SCRAPE_ALLOW_PRIVATE=1

