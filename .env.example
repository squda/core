# Copy to .env and fill in. .env is gitignored — the service role key is a
# server secret and must never reach a browser, a log, or this repository.

# Supabase — from Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Auth is required by default once Supabase is set. Set to 0 to run open
# while you are still wiring a client up.
# REQUIRE_AUTH=0

# PORT=3000
# LOG_LEVEL=info
# BROWSER_CONCURRENCY=2
# JOB_CONCURRENCY=4
# MAX_QUEUED=100

# Scrape private/loopback addresses. Local development only — never in
# production, where it re-opens the SSRF hole the guard exists to close.
# SCRAPE_ALLOW_PRIVATE=1

# Only used when Supabase is not configured.
# CACHE_PATH=.cache/scrape.db
