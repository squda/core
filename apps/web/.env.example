# Copy to .env.local. Next reads env files from this directory only — the root
# .env belongs to the service and is not visible here.

# Where the scrape service is. Server-side only, deliberately: not a
# NEXT_PUBLIC_ variable, so the url is never baked into the browser bundle.
# SCRAPE_SERVICE_URL=http://localhost:3000

# The waitlist writes through the service role key, which bypasses row-level
# security and must never reach a browser. Without both of these the waitlist
# route answers 503 and says so, rather than quietly dropping addresses.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
