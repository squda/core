{
  "name": "untitled",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "pnpm --filter @untitled/core scrape",
    "serve": "pnpm --filter @untitled/core serve",
    "web": "pnpm --filter @untitled/web dev",
    "dev": "pnpm --parallel --filter @untitled/core --filter @untitled/web dev",
    "test": "pnpm --filter @untitled/core test",
    "test:watch": "pnpm --filter @untitled/core test:watch",
    "test:browser": "pnpm --filter @untitled/core test:browser",
    "check:forms-live": "pnpm --filter @untitled/core check:forms-live",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^9.7.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^7.16.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1"
}
