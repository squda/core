{
  "name": "@untitled/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx src/cli.ts",
    "serve": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx --watch --env-file-if-exists=../../.env src/server.ts",
    "test": "vitest run",
    "fixture": "tsx tests/grab-fixture.ts",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "check:forms-live": "tsx tests/check-live-forms.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@mozilla/readability": "^0.5.0",
    "@supabase/supabase-js": "^2.112.3",
    "@untitled/schema": "workspace:*",
    "cheerio": "^1.0.0",
    "domhandler": "^6.0.1",
    "hono": "^4.13.2",
    "jsdom": "^24.1.0",
    "playwright": "^1.62.1",
    "tsx": "^4.16.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.5.0",
    "@types/turndown": "^5.0.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
