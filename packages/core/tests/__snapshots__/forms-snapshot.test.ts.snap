exports[`the FormSpec of every captured form > form-page 1`] = `
"FORM body:nth-of-type(1) > form:nth-of-type(1)
  POST → https://httpbin.org/post
  submit: body:nth-of-type(1) > form:nth-of-type(1) > p:nth-of-type(6) > button:nth-of-type(1)
  · Customer name:  [text]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custname"]
      from: label-wrapping  name=custname  id=-
  · Telephone:  [tel]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custtel"]
      from: label-wrapping  name=custtel  id=-
  · E-mail address:  [email]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custemail"]
      from: label-wrapping  name=custemail  id=-
  · Pizza Size  [radio]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="size"]
      from: label-wrapping  name=size  id=-
      options: Small=small, Medium=medium, Large=large
  · Pizza Toppings  [checkbox]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="topping"]
      from: label-wrapping  name=topping  id=-
      options: Bacon=bacon, Extra Cheese=cheese, Onion=onion, Mushroom=mushroom
  · Preferred delivery time:  [time]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="delivery"]
      from: label-wrapping  name=delivery  id=-
  · Delivery instructions:  [textarea]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="comments"]
      from: label-wrapping  name=comments  id=-"
`;

exports[`the FormSpec of every captured form > form-select-minimal 1`] = `
"FORM (controls outside any <form>)
  GET → (posts to itself)
  submit: (none found)
  · Dropdown List  [select]
      selector: #dropdown
      from: nearby-text  name=-  id=dropdown
      options: Please select an option=*, Option 1=1, Option 2=2"
`;

exports[`the FormSpec of every captured form > form-shadow-dom 1`] = `
"FORM #paymentForm
  GET → (posts to itself)
  submit: #paymentForm > button:nth-of-type(1)
  · John Doe  [text]  required
      selector: #cardName
      from: placeholder  name=-  id=cardName
      placeholder: John Doe
  · 1234 5678 9012 3456  [text]  required sensitive
      selector: #cardNumber
      from: placeholder  name=-  id=cardNumber
      placeholder: 1234 5678 9012 3456
      maxLength=19
  · MM/YY  [text]  required
      selector: #expiry
      from: placeholder  name=-  id=expiry
      placeholder: MM/YY
      maxLength=5
  · 123  [text]  required sensitive
      selector: #cvv
      from: placeholder  name=-  id=cvv
      placeholder: 123
      maxLength=4

FORM (controls outside any <form>)
  GET → (posts to itself)
  submit: (none found)
  · Enter email  [email]  readonly
      selector: #shub70
      from: placeholder  name=email  id=shub70
      autocomplete: anyrandomstring
      placeholder: Enter email
  · Enter Password  [password]  sensitive
      selector: #pass
      from: placeholder  name=Password  id=pass
      autocomplete: off_anyrandomstring
      placeholder: Enter Password
  · Enter your company  [text]
      selector: #content > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > input:nth-of-type(1)
      from: placeholder  name=company  id=-
      placeholder: Enter your company
  · Enter your mobile number  [number]
      selector: #content > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > input:nth-of-type(2)
      from: placeholder  name=mobile number  id=-
