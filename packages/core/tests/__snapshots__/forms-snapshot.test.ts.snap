  · User Name:  [text]
      selector: #email
      from: nearby-text  name=email  id=email
      maxLength=60
  · Password:  [password]  sensitive
      selector: body:nth-of-type(1) > div:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(4) > td:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(5) > td:nth-of-type(1) > form:nth-of-type(1) [name="password"]
      from: nearby-text  name=password  id=-
      maxLength=60
  · Confirm Password:  [password]  sensitive
      selector: body:nth-of-type(1) > div:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(4) > td:nth-of-type(1) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(1) > td:nth-of-type(2) > table:nth-of-type(1) > tbody:nth-of-type(1) > tr:nth-of-type(5) > td:nth-of-type(1) > form:nth-of-type(1) [name="confirmPassword"]
      from: nearby-text  name=confirmPassword  id=-
      maxLength=60"
`;

exports[`the FormSpec of every captured form > form-page 1`] = `
"FORM body:nth-of-type(1) > form:nth-of-type(1)
  POST → https://httpbin.org/post
  submit: body:nth-of-type(1) > form:nth-of-type(1) > p:nth-of-type(6) > button:nth-of-type(1)
  · Customer name:  [text]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custname"]
      from: label-wrapping  name=custname  id=-
  · Telephone:  [tel]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custtel"]
      from: label-wrapping  name=custtel  id=-
  · E-mail address:  [email]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="custemail"]
      from: label-wrapping  name=custemail  id=-
  · Pizza Size  [radio]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="size"]
      from: label-wrapping  name=size  id=-
      options:
        - Small=small
        - Medium=medium
        - Large=large
  · Pizza Toppings  [checkbox]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="topping"]
      from: label-wrapping  name=topping  id=-
      options:
        - Bacon=bacon
        - Extra Cheese=cheese
        - Onion=onion
        - Mushroom=mushroom
  · Preferred delivery time:  [time]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="delivery"]
      from: label-wrapping  name=delivery  id=-
  · Delivery instructions:  [textarea]
      selector: body:nth-of-type(1) > form:nth-of-type(1) [name="comments"]
      from: label-wrapping  name=comments  id=-"
`;

exports[`the FormSpec of every captured form > form-select-minimal 1`] = `
"FORM (controls outside any <form>)
  GET → (posts to itself)
  submit: (none found)
  · Dropdown List  [select]
      selector: #dropdown
      from: nearby-text  name=-  id=dropdown
      options:
        - Please select an option=*
        - Option 1=1
        - Option 2=2"
`;

exports[`the FormSpec of every captured form > form-signup 1`] = `
"FORM #root > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > form:nth-of-type(1)
  GET → (posts to itself)
  submit: #register-submit
  · Email Address  [email]
      selector: #register-email
      from: label-for  name=-  id=register-email
      placeholder: Enter your email
  · Password  [password]  sensitive
      selector: #register-password
      from: label-for  name=-  id=register-password
      placeholder: Create a password
  · Confirm Password  [password]  sensitive
      selector: #register-confirm-password
      from: label-for  name=-  id=register-confirm-password
      placeholder: Confirm your password"
`;
