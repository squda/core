      selector: #when-does-your-course-start > fieldset:nth-of-type(1) [name="response"]
      from: label-wrapping  name=response  id=radio-755923b6-0
      options:
        - On or after 1 January 2027=on-or-after-1-january-2027
        - Before January 2027=before-january-2027

FORM #something-is-wrong
  POST → https://www.gov.uk/contact/govuk/problem_reports
  submit: #something-is-wrong > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(5) > button:nth-of-type(1)
