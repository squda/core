exports[`the FormSpec of every captured form > form-login-minimal 1`] = `
"FORM #login
  POST → https://the-internet.herokuapp.com/authenticate
  submit: #login > button:nth-of-type(1)
  · Username  [text]
      selector: #username
      from: label-for  name=username  id=username
  · Password  [password]  sensitive
      selector: #password
      from: label-for  name=password  id=password"
`;

exports[`the FormSpec of every captured form > form-login-nolabels 1`] = `
"FORM #login_button_container > div:nth-of-type(1) > form:nth-of-type(1)
  GET → (posts to itself)
  submit: #login-button
  · Username  [text]
      selector: #user-name
      from: placeholder  name=user-name  id=user-name
      placeholder: Username
  · Password  [password]  sensitive
      selector: #password
      from: placeholder  name=password  id=password
      placeholder: Password"
`;

